{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "behavioral-fsm-benchmark/reference_fsm/v1",
  "title": "Gold / Reference FSM",
  "allOf": [{ "$ref": "generated_fsm.schema.json" }],
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["draft", "review", "approved", "deprecated", "placeholder"] },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"] },
        "source": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
