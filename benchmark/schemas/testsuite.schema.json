{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "behavioral-fsm-benchmark/testsuite/v1",
  "title": "Behavioral Test Suite",
  "type": "object",
  "required": ["system_name", "tests"],
  "properties": {
    "system_name": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" },
    "guard_contexts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["test_id", "events"],
        "properties": {
          "test_id": { "type": "string" },
          "kind": { "type": "string", "enum": ["oracle", "path", "negative", "invariant"] },
          "events": { "type": "array", "items": { "type": "string" } },
          "expected_final_state": { "type": ["string", "null"] },
          "expected_trace": { "type": "array", "items": { "type": "string" } },
          "guard_context": { "type": "object", "additionalProperties": true },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
