{
  "system_name": "ATM",
  "metadata": {
    "status": "approved",
    "tier": "pilot",
    "version": "1.0"
  },
  "tests": [
    {
      "test_id": "happy_path_withdraw",
      "kind": "oracle",
      "events": [
        "insert_card",
        "pin_ok",
        "select_withdraw",
        "dispense_complete",
        "eject_card"
      ],
      "expected_final_state": "Idle",
      "expected_trace": [
        "Authenticating",
        "Ready",
        "Dispensing",
        "Ready",
        "Idle"
      ],
      "description": "Full withdraw and eject returns to Idle"
    },
    {
      "test_id": "reject_insert_while_ready",
      "kind": "negative",
      "events": ["insert_card", "pin_ok", "insert_card"],
      "expected_final_state": null,
      "description": "Card insert rejected in Ready (R8)"
    },
    {
      "test_id": "pin_fail_returns_idle",
      "kind": "oracle",
      "events": ["insert_card", "pin_fail"],
      "expected_final_state": "Idle",
      "expected_trace": ["Authenticating", "Idle"],
      "description": "Invalid PIN returns to Idle (R4)"
    },
    {
      "test_id": "insert_card_only",
      "kind": "oracle",
      "events": ["insert_card"],
      "expected_final_state": "Authenticating",
      "description": "Card insert from Idle (R2)"
    },
    {
      "test_id": "reject_withdraw_from_idle",
      "kind": "negative",
      "events": ["select_withdraw"],
      "expected_final_state": null,
      "description": "Withdraw rejected from Idle"
    },
    {
      "test_id": "path_to_dispensing",
      "kind": "path",
      "events": ["insert_card", "pin_ok", "select_withdraw"],
      "expected_final_state": "Dispensing",
      "expected_trace": ["Authenticating", "Ready", "Dispensing"],
      "description": "Three-step path ending in Dispensing"
    },
    {
      "test_id": "initial_idle",
      "kind": "oracle",
      "events": [],
      "expected_final_state": "Idle",
      "description": "ATM starts Idle (R1)"
    },
    {
      "test_id": "ready_after_pin",
      "kind": "oracle",
      "events": ["insert_card", "pin_ok"],
      "expected_final_state": "Ready",
      "expected_trace": ["Authenticating", "Ready"],
      "description": "Valid PIN reaches Ready (R3)"
    },
    {
      "test_id": "dispense_returns_ready",
      "kind": "oracle",
      "events": ["insert_card", "pin_ok", "select_withdraw", "dispense_complete"],
      "expected_final_state": "Ready",
      "expected_trace": ["Authenticating", "Ready", "Dispensing", "Ready"],
      "description": "Dispense complete returns to Ready (R6)"
    },
    {
      "test_id": "path_pin_fail",
      "kind": "path",
      "events": ["insert_card", "pin_fail"],
      "expected_final_state": "Idle",
      "expected_trace": ["Authenticating", "Idle"],
      "description": "Path invalid PIN to Idle"
    },
    {
      "test_id": "path_eject",
      "kind": "path",
      "events": ["insert_card", "pin_ok", "eject_card"],
      "expected_final_state": "Idle",
      "expected_trace": ["Authenticating", "Ready", "Idle"],
      "description": "Path eject card to Idle (R7)"
    },
    {
      "test_id": "path_authenticating",
      "kind": "path",
      "events": ["insert_card"],
      "expected_final_state": "Authenticating",
      "description": "Path card insert only"
    },
    {
      "test_id": "path_ready",
      "kind": "path",
      "events": ["insert_card", "pin_ok"],
      "expected_final_state": "Ready",
      "description": "Path to Ready menu"
    },
    {
      "test_id": "path_full_cycle",
      "kind": "path",
      "events": [
        "insert_card",
        "pin_ok",
        "select_withdraw",
        "dispense_complete",
        "eject_card"
      ],
      "expected_final_state": "Idle",
      "description": "Path full withdraw cycle"
    },
    {
      "test_id": "path_idle",
      "kind": "path",
      "events": [],
      "expected_final_state": "Idle",
      "description": "Path initial Idle"
    },
    {
      "test_id": "reject_eject_idle",
      "kind": "negative",
      "events": ["eject_card"],
      "expected_final_state": null,
      "description": "Eject rejected from Idle"
    }
  ]
}
