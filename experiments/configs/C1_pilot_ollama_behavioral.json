  },
  "environment": {
    "hostname": null,
    "platform": null,
    "python_version": null,
    "git_commit": null,
    "notes": "Populated automatically at campaign start when fields are null."
  },
  "generation_policy": {
    "one_fsm_per_run": true,
    "repair_loop": false,
    "post_processing": "json_extraction_and_validation_only"
  },
  "expected_runs": 90
