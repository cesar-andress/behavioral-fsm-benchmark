{
  "schema_version": "1.0",
  "campaign_id": "C1_pilot_ollama_behavioral",
  "purpose": "behavioral",
  "description": "Overnight pilot campaign: local Ollama FSM generation and behavioral evaluation on three pilot systems.",
  "status": "active",
  "pilot": true,
  "systems": [
    "vending_machine",
    "login_system",
    "atm"
  ],
