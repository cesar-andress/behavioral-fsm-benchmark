{
  "schema_version": "1.0",
  "campaign_id": "C2_core_ollama_behavioral",
  "purpose": "behavioral",
  "description": "Full core-tier campaign: local Ollama FSM generation and behavioral evaluation on nine core systems not covered by C1.",
  "status": "active",
  "pilot": false,
  "depends_on_campaign": "C1_pilot_ollama_behavioral",
  "systems": [
    "parking_gate",
    "access_control",
    "bike_rental",
    "warehouse_inventory",
    "smart_thermostat",
    "elevator",
    "hotel_booking",
    "train_ticket_booking",
    "package_locker"
  ],
  "models": [
    "qwen2.5-coder:7b",
    "llama3.1:8b",
    "mistral-nemo:12b",
    "gemma2:9b"
  ],
  "replicates": 5,
  "inference": {
    "backend": "ollama",
    "temperature": 0.0,
    "structured_output": true,
    "num_ctx": 8192,
    "timeout_seconds": 600,
    "ollama_host": "http://localhost:11434"
  },
  "prompt_template": "prompts/behavioral_fsm_generation.md",
  "system_message": "You are a formal methods engineer. Produce exactly one finite state machine as JSON that satisfies the given requirements. Return JSON only with no prose, markdown, or commentary.",
  "schema_reference": "benchmark/schemas/generated_fsm.schema.json",
  "output": {
    "base_dir": "experiments/runs/C2_core_ollama_behavioral",
    "timestamp_policy": "utc_iso_compact"
  },
  "environment": {
    "hostname": null,
    "platform": null,
    "python_version": null,
    "git_commit": null,
    "notes": "Populated automatically at campaign start when fields are null. C1 pilot runs (vending_machine, login_system, atm) are not regenerated."
  },
  "generation_policy": {
    "one_fsm_per_run": true,
    "repair_loop": false,
    "post_processing": "json_extraction_and_validation_only"
  },
  "expected_runs": 180
}
