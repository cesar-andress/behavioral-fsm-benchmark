{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fsm-behavior-bench/run-record/v1",
  "title": "Experiment Run Record",
  "type": "object",
  "required": ["run_id", "campaign_id", "model", "system", "timestamp_utc", "status"],
  "properties": {
    "run_id": { "type": "string", "format": "uuid" },
    "campaign_id": { "type": "string" },
    "model": { "type": "string" },
    "system": { "type": "string" },
    "repeat_index": { "type": "integer", "minimum": 1 },
    "perturbation_variant": { "type": ["string", "null"] },
    "git_commit": { "type": "string" },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["pending", "running", "completed", "failed", "skipped"] },
    "error": { "type": ["string", "null"] },
    "output_paths": {
      "type": "object",
      "properties": {
        "raw": { "type": "string" },
        "cleaned": { "type": "string" }
      }
    },
    "metrics_snapshot": { "type": "object" }
  }
}
