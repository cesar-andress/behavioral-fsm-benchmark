# Paper repository hygiene — EMSE 2026 manuscript
# See REPOSITORY_HYGIENE.md for the full policy.

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls
*.pdf

# Python (artifact generation scripts)
scripts/.venv/
scripts/__pycache__/
*.py[cod]

# Regeneratable figure sidecar markers
figures/*.autogen

# Publication figures — whitelist only (see figures/FIGURES.md)
figures/*
!figures/FIGURES.md
# Uncomment when figures are generated:
# !figures/structural_behavioral_gap.png
# !figures/structural_behavioral_gap.svg
# !figures/oracle_failure_taxonomy.png
# !figures/oracle_failure_taxonomy.svg
# !figures/perturbation_sensitivity.png
# !figures/perturbation_sensitivity.svg
# !figures/reproducibility_variance.png
# !figures/reproducibility_variance.svg

# Never commit raw benchmark outputs
results/
outputs/
metrics.csv
**/metrics.csv
**/manifest_*.json
